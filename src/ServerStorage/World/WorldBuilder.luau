--!nolint
-- The entire map is generated by code: a void floor, a plaza with an obelisk,
-- twelve player plots, a spawn pad, a starfield and the server-best board.
-- No imported assets or Studio building required.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Riftfall")
local Config = require(Shared.Config)

local WorldBuilder = {}

local SPARKLE_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"
local ACCENT = Color3.fromRGB(120, 220, 255)
local DEEP = Color3.fromRGB(10, 12, 22)

local function part(props)
	local created = Instance.new("Part")
	created.Name = props.name or "Part"
	created.Anchored = true
	created.CanCollide = props.collide == true
	created.CanQuery = props.collide == true
	created.CanTouch = false
	created.CastShadow = props.shadow == true
	created.Material = props.material or Enum.Material.SmoothPlastic
	created.Color = props.color or DEEP
	created.Size = props.size
	created.CFrame = props.cframe
	created.Transparency = props.transparency or 0
	created.Parent = props.parent
	return created
end

local function disc(props)
	local created = part(props)
	created.Shape = Enum.PartType.Cylinder
	created.CFrame = props.cframe * CFrame.Angles(0, 0, math.rad(90))
	return created
end

local function makeSign(cframe, width, height)
	local board = part({
		name = "Sign",
		size = Vector3.new(width, height, 0.6),
		cframe = cframe,
		color = Color3.fromRGB(18, 24, 44),
		material = Enum.Material.Metal,
	})
	local surface = Instance.new("SurfaceGui")
	surface.Name = "SignGui"
	surface.Face = Enum.NormalId.Front
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 40
	surface.LightInfluence = 0
	surface.Parent = board

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = Color3.fromRGB(226, 236, 255)
	label.TextStrokeTransparency = 1
	label.TextWrapped = true
	label.TextScaled = true
	label.Text = ""
	label.Parent = surface

	return board, label
end

local function buildLighting()
	Lighting.ClockTime = 0
	Lighting.GeographicLatitude = 0
	Lighting.Brightness = 1.15
	Lighting.Ambient = Color3.fromRGB(30, 34, 52)
	Lighting.OutdoorAmbient = Color3.fromRGB(18, 20, 34)
	Lighting.EnvironmentDiffuseScale = 0.35
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	Lighting.FogColor = Color3.fromRGB(12, 14, 26)
	Lighting.FogStart = 260
	Lighting.FogEnd = 1100
	Lighting.ShadowSoftness = 0.35

	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if not atmosphere then
		atmosphere = Instance.new("Atmosphere")
		atmosphere.Parent = Lighting
	end
	atmosphere.Density = 0.32
	atmosphere.Offset = 0.1
	atmosphere.Color = Color3.fromRGB(70, 84, 140)
	atmosphere.Decay = Color3.fromRGB(22, 26, 54)
	atmosphere.Glare = 0.4
	atmosphere.Haze = 1.4

	local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
	if not bloom then
		bloom = Instance.new("BloomEffect")
		bloom.Parent = Lighting
	end
	bloom.Intensity = 1.1
	bloom.Size = 32
	bloom.Threshold = 0.85

	local correction = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
	if not correction then
		correction = Instance.new("ColorCorrectionEffect")
		correction.Name = "RiftfallGrade"
		correction.Parent = Lighting
	end
	correction.Saturation = 0.15
	correction.Contrast = 0.08
	correction.TintColor = Color3.fromRGB(255, 255, 255)
end

local function buildSky(parent)
	for index = 1, 170 do
		local angle = math.random() * math.pi * 2
		local height = math.random(-15, 75) / 100
		local direction = Vector3.new(math.cos(angle), height, math.sin(angle)).Unit
		local distance = math.random(520, 980)
		local size = math.random(12, 34) / 10
		local star = part({
			name = "Star",
			size = Vector3.new(size, size, size),
			cframe = CFrame.new(direction * distance),
			color = Color3.fromRGB(
				math.random(190, 255),
				math.random(210, 255),
				255
			),
			material = Enum.Material.Neon,
			transparency = math.random(10, 45) / 100,
		})
		star.CastShadow = false
		star.Parent = parent
	end
end

function WorldBuilder.build()
	buildLighting()

	local world = Instance.new("Model")
	world.Name = "RiftfallWorld"
	world.Parent = Workspace

	part({
		name = "VoidFloor",
		size = Vector3.new(1600, 2, 1600),
		cframe = CFrame.new(0, -2, 0),
		color = Color3.fromRGB(7, 9, 16),
		material = Enum.Material.Slate,
		collide = true,
		shadow = true,
		parent = world,
	})

	local plazaRadius = 170
	disc({
		name = "Plaza",
		size = Vector3.new(2, plazaRadius * 2, plazaRadius * 2),
		cframe = CFrame.new(0, 0.1, 0),
		color = Color3.fromRGB(16, 20, 36),
		material = Enum.Material.Slate,
		collide = true,
		parent = world,
	})

	-- Dashed neon ring around the plaza edge.
	for index = 1, 64 do
		local angle = (index / 64) * math.pi * 2
		local position = Vector3.new(math.cos(angle) * (plazaRadius - 2), 1.2, math.sin(angle) * (plazaRadius - 2))
		part({
			name = "PlazaRing",
			size = Vector3.new(13, 0.5, 1.4),
			cframe = CFrame.new(position) * CFrame.Angles(0, -angle + math.pi / 2, 0),
			color = ACCENT,
			material = Enum.Material.Neon,
			transparency = 0.35,
			parent = world,
		})
	end

	-- Obelisk
	part({
		name = "Obelisk",
		size = Vector3.new(9, 34, 9),
		cframe = CFrame.new(0, 17, 0) * CFrame.Angles(0, math.rad(45), 0),
		color = Color3.fromRGB(22, 28, 48),
		material = Enum.Material.Metal,
		collide = true,
		parent = world,
	})
	local crystal = part({
		name = "ObeliskCrystal",
		size = Vector3.new(10, 10, 10),
		cframe = CFrame.new(0, 42, 0) * CFrame.Angles(math.rad(35), math.rad(20), math.rad(35)),
		color = ACCENT,
		material = Enum.Material.Neon,
		transparency = 0.15,
		parent = world,
	})
	local crystalGlow = Instance.new("PointLight")
	crystalGlow.Color = ACCENT
	crystalGlow.Brightness = 3
	crystalGlow.Range = 120
	crystalGlow.Shadows = false
	crystalGlow.Parent = crystal

	local podium = disc({
		name = "Podium",
		size = Vector3.new(3, 22, 22),
		cframe = CFrame.new(0, 2, 0),
		color = Color3.fromRGB(20, 26, 46),
		material = Enum.Material.Metal,
		collide = true,
		parent = world,
	})
	podium.CanCollide = true

	-- Spawn pad
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "RiftfallSpawn"
	spawn.Size = Vector3.new(16, 1, 16)
	spawn.CFrame = CFrame.new(0, 1.5, 46)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Transparency = 1
	spawn.CanCollide = true
	spawn.Parent = world
	disc({
		name = "SpawnGlow",
		size = Vector3.new(0.4, 22, 22),
		cframe = CFrame.new(0, 2.4, 46),
		color = ACCENT,
		material = Enum.Material.Neon,
		transparency = 0.55,
		parent = world,
	})

	-- Ambient embers above the plaza
	local emitterAnchor = part({
		name = "EmberAnchor",
		size = Vector3.new(4, 4, 4),
		cframe = CFrame.new(0, 30, 0),
		transparency = 1,
		parent = world,
	})
	local embers = Instance.new("ParticleEmitter")
	embers.Name = "Embers"
	embers.Texture = SPARKLE_TEXTURE
	embers.Rate = 10
	embers.Lifetime = NumberRange.new(6, 12)
	embers.Speed = NumberRange.new(0.6, 2.2)
	embers.SpreadAngle = Vector2.new(70, 70)
	embers.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.9),
		NumberSequenceKeypoint.new(1, 0),
	})
	embers.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 1),
	})
	embers.Color = ColorSequence.new(ACCENT)
	embers.LightEmission = 1
	embers.LightInfluence = 0
	embers.Parent = emitterAnchor

	buildSky(world)

	-- Server best board, facing the spawn pad.
	local boardPos = Vector3.new(0, 30, -55)
	local board, bestLabel = makeSign(CFrame.lookAt(boardPos, Vector3.new(0, 22, 46)), 30, 12)
	board.Name = "BestBoard"
	board.Material = Enum.Material.Metal
	board.Color = Color3.fromRGB(14, 18, 34)
	board.Parent = world
	bestLabel.Text = "SERVER BEST\nno rifts yet"
	bestLabel.TextColor3 = Color3.fromRGB(255, 246, 214)

	-- Player plots
	local plots = {}
	for index = 1, Config.Plot.Count do
		local angle = ((index - 1) / Config.Plot.Count) * math.pi * 2
		local position = Vector3.new(math.cos(angle) * Config.Plot.Radius, 0, math.sin(angle) * Config.Plot.Radius)
		local plotCFrame = CFrame.lookAt(position, Vector3.new(0, 0, 0))

		local pad = part({
			name = "PlotPad_" .. index,
			size = Vector3.new(Config.Plot.Size, 1.4, Config.Plot.Size),
			cframe = plotCFrame * CFrame.new(0, 0.4, 0),
			color = Color3.fromRGB(20, 26, 46),
			material = Enum.Material.Slate,
			collide = true,
			shadow = true,
			parent = world,
		})
		pad.CanCollide = true

		disc({
			name = "Pedestal_" .. index,
			size = Vector3.new(2.4, 14, 14),
			cframe = plotCFrame * CFrame.new(0, 2, 0),
			color = Color3.fromRGB(30, 38, 64),
			material = Enum.Material.Metal,
			collide = true,
			parent = world,
		}).CanCollide = true

		local trim = part({
			name = "PlotTrim_" .. index,
			size = Vector3.new(Config.Plot.Size, 0.25, Config.Plot.Size),
			cframe = plotCFrame * CFrame.new(0, 1.15, 0),
			color = Color3.fromRGB(70, 110, 190),
			material = Enum.Material.Neon,
			transparency = 0.35,
			parent = world,
		})
		trim.CanCollide = false

		local plotSign, signLabel = makeSign(
			plotCFrame * CFrame.new(0, 9, Config.Plot.Size * 0.46),
			Config.Plot.Size * 0.9,
			8
		)
		plotSign.Parent = world
		signLabel.Text = "empty plot"

		table.insert(plots, {
			index = index,
			cframe = plotCFrame,
			portalCFrame = plotCFrame * CFrame.new(0, Config.Plot.PedestalHeight, 0),
			signLabel = signLabel,
			models = {},
			owner = nil,
		})
	end

	-- Only now remove the placeholder floor. Clearing it up front left a gap
	-- where a character could spawn with nothing underneath and fall forever.
	--
	-- Remove the two objects this place actually ships, by name. A blanket sweep
	-- over Workspace also reaches Terrain (a BasePart subclass) and threw there,
	-- which aborted the build before it returned its layout. Cleanup must never
	-- be able to stop the world from being handed back.
	local function removePlaceholder(instance)
		if not instance or instance == world then
			return
		end
		local removed, err = pcall(function()
			instance:Destroy()
		end)
		if not removed then
			warn("Riftfall: could not remove placeholder " .. instance.Name .. ": " .. tostring(err))
		end
	end

	removePlaceholder(Workspace:FindFirstChild("Baseplate"))
	removePlaceholder(Workspace:FindFirstChild("SpawnLocation"))

	Workspace:SetAttribute("RiftfallWorld", true)

	return {
		world = world,
		plots = plots,
		spawnCFrame = CFrame.new(0, 5, 46),
		bestLabel = bestLabel,
	}
end

return WorldBuilder
